# Razorpay credentials. Use test keys outside Production.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Optional for local testing. Add this only when you configure the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=replace_me

# Neon pooled connection string supplied by the Vercel/Neon integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# If the Vercel integration uses this legacy name, it is supported as well.
# POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Total seats that can be sold for this workshop.
POSH_WORKSHOP_CAPACITY=50

# Maximum order attempts per IP address in a fixed 10-minute window.
POSH_ORDER_RATE_LIMIT=5

# Optional. When both values are present, successful registrations receive email.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=MpowHR <workshops@example.com>
